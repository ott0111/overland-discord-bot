# Overland Core - copy to .env and fill in. Never commit real values.
# See docs/SETUP.md section 3 for what each variable does and where to find it.
# Discord - required. Get these from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# The dashboard team API reads DISCORD_GUILD_ID (GUILD_ID is kept as a legacy fallback).
# Only DISCORD_GUILD_ID needs to be set.
# Database (PostgreSQL) - required. Prisma reads DATABASE_URL from the schema.
DATABASE_URL="postgresql://overland:password@localhost:5432/overland_core?schema=public"
# Redis (optional; enables durable BullMQ workers and delayed jobs)
REDIS_URL="redis://localhost:6379"
# X (Twitter) API v2 - required for X integration; leave blank to disable gracefully
X_BEARER_TOKEN=
X_USERNAME=OverlandFinance
# Dashboard / OAuth2 - NEXTAUTH_URL must match the public dashboard URL.
# The redirect URI registered in Discord is NEXTAUTH_URL + /api/auth/callback
NEXTAUTH_URL=http://localhost:3000
# Session signing. The dashboard HMAC-signs its session cookie with
# DASHBOARD_SESSION_SECRET (falling back to NEXTAUTH_SECRET). Set a long random
# value; login fails loudly without one rather than issuing an unsigned cookie.
NEXTAUTH_SECRET=
DASHBOARD_SESSION_SECRET=
# App
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
