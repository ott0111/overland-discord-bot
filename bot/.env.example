DISCORD_TOKEN=
# Application ID from Discord Developer Portal, not the guild/server ID.
DISCORD_CLIENT_ID=
# Strongly recommended for instant slash-command registration while testing.
DISCORD_GUILD_ID=
# Bootstrap the first internal Owner. Use your Discord user ID.
OVERLAND_OWNER_DISCORD_ID=
OVERLAND_OWNER_USERNAME=Owner
# Optional X API bearer token for automatic timeline announcements.
X_BEARER_TOKEN=
# Optional URL used in branded embeds.
OVERLAND_ICON_URL=

# Storage backend: "json" keeps the existing local file; "mysql" enables CoalByte/MySQL.
# Keep "json" until the MySQL schema and import dry-run have been reviewed.
OVERLAND_STORAGE=json
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_POOL_SIZE=5
# Set true only when your database provider requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
